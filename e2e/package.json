{
  "name": "e2e",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "transpile": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && babel --extensions .ts --out-dir dist src",
    "precucumber": "node -e \"const fs=require('fs');fs.rmSync('reports',{recursive:true,force:true});fs.mkdirSync('reports',{recursive:true});fs.writeFileSync('reports/reports.json','{}')\"",
    "cucumber": "npm run transpile && cucumber-js",
    "cucumber:localhost": "yarn cucumber",
    "cucumber:production": "yarn cucumber",
    "postcucumber": "ts-node ./src/reporter/cucumber-report.ts"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/cli": "^7.23.4",
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-typescript": "^7.23.3",
    "@cucumber/cucumber": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "playwright": "^1.64.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "cucumber-html-reporter": "^7.1.1",
    "dotenv": "^8.2.0"
  }
}
